<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <title>Welcome to Taskflow</title>
  <style>
    /* Reset */
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; display: block; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #0a0d14; }

    /* Base */
    .wrapper { width: 100%; background-color: #0a0d14; background-image: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(51,153,255,0.18), transparent 70%); padding: 40px 16px; }
    .container { max-width: 600px; margin: 0 auto; background: #11151f; border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; overflow: hidden; }
    .px { padding-left: 40px; padding-right: 40px; }

    /* Typography */
    .h1 { font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 32px; line-height: 1.2; font-weight: 700; color: #f1f5fb; margin: 0 0 16px; }
    .h2 { font-family: 'Space Grotesk', -apple-system, sans-serif; font-size: 18px; font-weight: 600; color: #f1f5fb; margin: 0 0 12px; }
    .p { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 16px; line-height: 1.65; color: #aab3c2; margin: 0 0 16px; }
    .muted { color: #6b7488; font-size: 13px; }

    .gradient-text {
      background: linear-gradient(135deg, #3399ff, #1ad6c7);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: #3399ff;
    }

    /* Header */
    .header { padding: 32px 40px 0; text-align: left; }
    .brand { font-family: 'Space Grotesk', sans-serif; font-size: 18px; font-weight: 700; color: #f1f5fb; letter-spacing: -0.01em; }
    .brand-dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: linear-gradient(135deg, #3399ff, #1ad6c7); margin-right: 10px; vertical-align: middle; }

    /* Hero */
    .hero { padding: 40px; text-align: left; }

    /* Button */
    .btn-wrap { padding: 8px 0 24px; }
    .btn { display: inline-block; background: linear-gradient(135deg, #3399ff, #1ad6c7); color: #0a0d14 !important; text-decoration: none; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 15px; padding: 14px 28px; border-radius: 12px; }

    /* Features */
    .features { padding: 8px 40px 32px; }
    .feature { padding: 16px 0; border-top: 1px solid rgba(255,255,255,0.06); }
    .feature:first-child { border-top: none; }
    .feature-icon { display: inline-block; width: 36px; height: 36px; border-radius: 10px; background: rgba(51,153,255,0.12); color: #3399ff; text-align: center; line-height: 36px; font-size: 18px; font-weight: 700; vertical-align: middle; margin-right: 14px; font-family: 'Space Grotesk', sans-serif; }

    /* Divider */
    .divider { height: 1px; background: rgba(255,255,255,0.06); margin: 0 40px; }

    /* Footer */
    .footer { padding: 28px 40px 36px; text-align: center; }
    .footer a { color: #6b7488; text-decoration: none; }
    .social { padding: 8px 0 16px; }
    .social a { display: inline-block; margin: 0 10px; color: #aab3c2; font-family: 'Inter', sans-serif; font-size: 13px; text-decoration: none; }

    @media only screen and (max-width: 600px) {
      .wrapper { padding: 16px 8px !important; }
      .px, .header, .hero, .features, .footer { padding-left: 24px !important; padding-right: 24px !important; }
      .divider { margin-left: 24px !important; margin-right: 24px !important; }
      .h1 { font-size: 26px !important; }
      .btn { display: block !important; text-align: center; }
    }

    @media (prefers-color-scheme: light) {
      /* Keep dark — brand is dark-first */
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <table role="presentation" class="container" cellpadding="0" cellspacing="0" border="0" width="100%">
      <!-- Header -->
      <tr>
        <td class="header">
          <span class="brand"><span class="brand-dot"></span>Taskflow</span>
        </td>
      </tr>

      <!-- Hero -->
      <tr>
        <td class="hero">
          <h1 class="h1">Welcome, <span class="gradient-text"><%= name %></span> 👋</h1>
          <p class="p">
            You're in. TaskManager is built for makers who'd rather ship than juggle endless to-do lists. Here's a quick tour to get you moving.
          </p>
          <div class="btn-wrap">
            <a href="<%='#' %>" class="btn">Open your dashboard →</a>
          </div>
        </td>
      </tr>

      <!-- Divider -->
      <tr><td><div class="divider"></div></td></tr>

      <!-- Features -->
      <tr>
        <td class="features">
          <h2 class="h2" style="margin-top: 20px;">Three things to try first</h2>

          <div class="feature">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td width="50" valign="top"><span class="feature-icon">1</span></td>
                <td valign="top">
                  <h2 class="h2" style="font-size: 15px; margin: 4px 0 4px;">Create your first task</h2>
                  <p class="p" style="font-size: 14px; margin: 0;">Capture anything on your mind — Taskflow keeps it organized so you don't have to.</p>
                </td>
              </tr>
            </table>
          </div>

          <div class="feature">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td width="50" valign="top"><span class="feature-icon">2</span></td>
                <td valign="top">
                  <h2 class="h2" style="font-size: 15px; margin: 4px 0 4px;">Set priorities that matter</h2>
                  <p class="p" style="font-size: 14px; margin: 0;">Flag what's urgent so you always know what to ship next.</p>
                </td>
              </tr>
            </table>
          </div>

          <div class="feature">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td width="50" valign="top"><span class="feature-icon">3</span></td>
                <td valign="top">
                  <h2 class="h2" style="font-size: 15px; margin: 4px 0 4px;">Track your momentum</h2>
                  <p class="p" style="font-size: 14px; margin: 0;">Watch your completion rate climb as you knock items out — clarity, focus, done.</p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>

      <!-- Divider -->
      <tr><td><div class="divider"></div></td></tr>

      <!-- Sign-off -->
      <tr>
        <td class="hero" style="padding-top: 28px; padding-bottom: 28px;">
          <p class="p" style="margin-bottom: 8px;">Questions? Just reply to this email — a real human is on the other side.</p>
          <p class="p" style="margin: 0;">— The Taskflow team</p>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td class="footer">
          <div class="social">
            <a href="<%= '#' %>">Twitter</a>
            <a href="<%= '#' %>">GitHub</a>
            <a href="<%= '#' %>">Discord</a>
          </div>
          <p class="p muted" style="margin: 0 0 6px;">
            © <%= new Date().getFullYear() %> Taskflow. All rights reserved.
          </p>
          <p class="p muted" style="margin: 0;">
            You're receiving this because you signed up for Taskflow.
            <a href="<%='#' %>" style="color: #3399ff; text-decoration: none;">Unsubscribe</a>
          </p>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
